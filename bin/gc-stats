#!/usr/bin/env python3
"""Stream system metrics as NDJSON, one line per interval.

    gc-stats [--interval 1.0]

Streaming rather than one-shot because CPU load is a *delta* — a single read of
/proc/stat says nothing, and spawning a process a second to sample twice would
cost more than the thing being measured. The overlay starts this when it opens
and kills it when it closes.

Everything here is read from /proc and /sys except the GPU, which comes from
nvidia-smi on NVIDIA and from sysfs on AMD. A metric that cannot be read is
absent from the JSON rather than zero, so the overlay can leave the row out
instead of confidently displaying 0%.

Deliberately not here: frames per second. Only something running inside the
game's own process can count its frames — that is what MangoHud's Vulkan and
OpenGL layers are for, and pretending otherwise with a guess from the outside
would be worse than saying so.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time

HWMON = "/sys/class/hwmon"
DRM = "/sys/class/drm"


def read(path, default=""):
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return default


def cpu_times():
    line = read("/proc/stat").split("\n")[0]
    parts = [int(p) for p in line.split()[1:] if p.isdigit()]
    if len(parts) < 4:
        return None
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    return sum(parts), idle


def mem_stats():
    info = {}
    for line in read("/proc/meminfo").split("\n"):
        key, _, rest = line.partition(":")
        value = rest.strip().split(" ")[0]
        if value.isdigit():
            info[key] = int(value)
    total = info.get("MemTotal", 0)
    avail = info.get("MemAvailable", 0)
    if not total:
        return None
    return {"usedMb": round((total - avail) / 1024), "totalMb": round(total / 1024),
            "percent": round((total - avail) / total * 100)}


def cpu_temp():
    """First sensor that looks like a package temperature."""
    for entry in sorted(os.listdir(HWMON)) if os.path.isdir(HWMON) else []:
        base = os.path.join(HWMON, entry)
        name = read(os.path.join(base, "name"))
        if name not in ("k10temp", "coretemp", "zenpower", "cpu_thermal"):
            continue
        for label_file in sorted(f for f in os.listdir(base) if re.match(r"temp\d+_input", f)):
            value = read(os.path.join(base, label_file))
            if value.isdigit():
                return round(int(value) / 1000)
    return None


class Gpu:
    """NVIDIA through nvidia-smi, AMD and Intel through sysfs."""

    def __init__(self):
        self.smi = shutil.which("nvidia-smi")
        self.amd = None
        if not self.smi:
            for card in sorted(os.listdir(DRM)) if os.path.isdir(DRM) else []:
                busy = os.path.join(DRM, card, "device", "gpu_busy_percent")
                if os.path.exists(busy):
                    self.amd = os.path.join(DRM, card, "device")
                    break

    def read(self):
        if self.smi:
            return self._nvidia()
        if self.amd:
            return self._amd()
        return None

    def _nvidia(self):
        try:
            out = subprocess.run(
                [self.smi, "--query-gpu=utilization.gpu,memory.used,memory.total,"
                           "temperature.gpu,power.draw",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=3).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return None
        if not out:
            return None
        parts = [p.strip() for p in out.split("\n")[0].split(",")]
        if len(parts) < 4:
            return None

        def num(value):
            try:
                return round(float(value))
            except ValueError:
                return None

        return {"percent": num(parts[0]), "vramUsedMb": num(parts[1]),
                "vramTotalMb": num(parts[2]), "temp": num(parts[3]),
                "watts": num(parts[4]) if len(parts) > 4 else None}

    def _amd(self):
        busy = read(os.path.join(self.amd, "gpu_busy_percent"))
        used = read(os.path.join(self.amd, "mem_info_vram_used"))
        total = read(os.path.join(self.amd, "mem_info_vram_total"))
        temp = None
        hwmon_dir = os.path.join(self.amd, "hwmon")
        if os.path.isdir(hwmon_dir):
            for entry in os.listdir(hwmon_dir):
                value = read(os.path.join(hwmon_dir, entry, "temp1_input"))
                if value.isdigit():
                    temp = round(int(value) / 1000)
                    break
        return {
            "percent": int(busy) if busy.isdigit() else None,
            "vramUsedMb": round(int(used) / 1048576) if used.isdigit() else None,
            "vramTotalMb": round(int(total) / 1048576) if total.isdigit() else None,
            "temp": temp,
            "watts": None,
        }


def emit(obj):
    obj["v"] = 1
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def main():
    interval = 1.0
    for i, a in enumerate(sys.argv):
        if a == "--interval" and i + 1 < len(sys.argv):
            try:
                interval = max(0.25, min(10.0, float(sys.argv[i + 1])))
            except ValueError:
                pass

    gpu = Gpu()
    emit({"t": "hello", "gpu": "nvidia" if gpu.smi else ("amd" if gpu.amd else "none"),
          "interval": interval})

    previous = cpu_times()
    while True:
        time.sleep(interval)
        sample = {"t": "stats"}

        current = cpu_times()
        if previous and current:
            total_delta = current[0] - previous[0]
            idle_delta = current[1] - previous[1]
            if total_delta > 0:
                sample["cpu"] = {"percent": round((1 - idle_delta / total_delta) * 100)}
        previous = current

        temp = cpu_temp()
        if temp is not None:
            sample.setdefault("cpu", {})["temp"] = temp

        memory = mem_stats()
        if memory:
            sample["ram"] = memory

        gpu_stats = gpu.read()
        if gpu_stats:
            sample["gpu"] = gpu_stats

        emit(sample)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
